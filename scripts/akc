#!/bin/bash
# akc — AI KeyChain Secret Reference resolver
# Resolves keychain:// references in environment variables and runs the given command.
#
# Usage:
#   akc run -- <command> [args...]
#   akc run --dry-run
#
# Environment variables with values matching "keychain://<KEY_NAME>" are resolved
# via macOS Keychain (security find-generic-password) and injected into the
# child process environment. The parent process env is never modified.
#
# v2.0 (#188): managed namespace が唯一の保管場所。
#   service="com.aieo.aikeychain.managed" account="<KEY_NAME>"
# security 所有なのでヘッドレス読取はプロンプト/ハングしない。旧 v1.x の
# GUI store / manual スキームは読まない（旧ユーザーはキーを再登録する）。

set -euo pipefail

# security(1) をバイナリ名解決 (PATH lookup) で呼ぶと、同一UIDの攻撃者や
# npm パッケージの悪意ある postinstall が PATH 上に偽の "security" を
# 先に置くことでシークレットを横取りできてしまう (#117 と同種の脅威)。
# 絶対パスに固定して PATH ハイジャックを防ぐ。
readonly SECURITY_BIN="/usr/bin/security"
# env も秘密解決パス上にある: `< <(env)` の env が偽装されると
# `VAR=keychain://KEY` 行を捏造して任意の Keychain 値を解決・export させられる。
readonly ENV_BIN="/usr/bin/env"

VERSION="2.0.0"

usage() {
    cat <<'USAGE'
akc — AI KeyChain Secret Reference resolver

Usage:
  akc run [--dry-run] -- <command> [args...]
  akc version
  akc help

Commands:
  run        Resolve keychain:// references and execute a command
  version    Show version
  help       Show this help

Options:
  --dry-run  Show which variables would be resolved (values are masked)

Examples:
  akc run -- python my_script.py
  akc run -- claude
  akc run --dry-run
USAGE
}

# security の有界実行 (#171): keychain がロック中等では読取が無期限にブロック
# し得る。macOS に timeout(1) は無いため、watchdog サブシェル + SIGKILL で
# 上限を設ける（防御。managed=security 所有なので通常はプロンプトしない）。
#
# 設計上の不変条件 (#185 レビュー B1): シークレット値は**ディスクに書かない**。
# 値は command substitution のパイプ内だけを流れる（一時ファイル方式は同一 UID
# 攻撃者に平文を窃取される実証があり不採用）。watchdog の stdout は /dev/null に
# 切り離してパイプを握らせない。
#
# 戻り値: security の rc。124 = タイムアウト（watchdog が SIGKILL 済み）。
# 注: 非対話シェルの background job は自プロセスグループを共有するため、
# グループ kill（kill -9 -PID）は自分ごと殺してしまい使えない。代わりに
# 直接の子孫 1 世代を pkill -P で先に回収してから子 PID を kill する。
# Swift 側 (SecurityCLIKeychainService) は別プロセスグループを持つため
# グループ kill を使う — 意味論の差は意図的（#185 レビュー S2 参照）。
AKC_SECURITY_TIMEOUT_SECS="${AKC_SECURITY_TIMEOUT_SECS:-10}"
# 算術評価 $(( )) は変数展開時に配列添字のコマンド置換まで評価するため、
# 未検証の環境変数を入れると env 注入 → 任意コマンド実行になる (#185 レビュー B2)。
# 数字のみ・1〜600 秒に厳格制限し、それ以外は既定 10 秒に落とす。
case "$AKC_SECURITY_TIMEOUT_SECS" in
    ''|*[!0-9]*) AKC_SECURITY_TIMEOUT_SECS=10 ;;
esac
if [ "$AKC_SECURITY_TIMEOUT_SECS" -lt 1 ] || [ "$AKC_SECURITY_TIMEOUT_SECS" -gt 600 ]; then
    AKC_SECURITY_TIMEOUT_SECS=10
fi

security_bounded() {
    local out rc capture_err=false
    # --stderr: stdout を捨てて stderr を返す（メタデータ照会の診断専用。
    # -w 付きの値読取には使わない — 値は stdout にしか出ないため混入しない）。
    if [ "${1:-}" = "--stderr" ]; then capture_err=true; shift; fi
    out=$(
        if $capture_err; then
            "$SECURITY_BIN" "$@" 2>&1 >/dev/null &
        else
            "$SECURITY_BIN" "$@" 2>/dev/null &
        fi
        pid=$!
        (
            w=0
            lim=$((AKC_SECURITY_TIMEOUT_SECS * 10))
            while kill -0 "$pid" 2>/dev/null && [ "$w" -lt "$lim" ]; do
                sleep 0.1
                w=$((w + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                # 子孫(1世代)の PID を先に控えてから、親 → 子孫の順で kill する。
                # 子孫を放置すると stdout パイプを握り続けてコマンド置換が
                # パイプ閉鎖まで待たされ有界性が壊れる。親 kill 後は reparent
                # されて -P で辿れないため、リストは kill 前に取る。親を先に
                # 殺すのは rc=137 (timeout 判定) を確実にするため。
                # (/usr/bin/security は単一プロセスなので通常は no-op)
                kids=$(/usr/bin/pgrep -P "$pid" 2>/dev/null || true)
                kill -9 "$pid" 2>/dev/null
                if [ -n "$kids" ]; then
                    # shellcheck disable=SC2086 — PID リストの word splitting は意図
                    kill -9 $kids 2>/dev/null || true
                fi
            fi
        ) >/dev/null 2>&1 &
        wpid=$!
        if wait "$pid"; then rc=0; else rc=$?; fi
        kill "$wpid" 2>/dev/null || true
        exit "$rc"
    )
    rc=$?
    if [ "$rc" -eq 137 ]; then   # 128+SIGKILL = watchdog による timeout
        return 124
    fi
    printf '%s' "$out"
    return "$rc"
}

resolve_keychain() {
    local key_name="$1"
    local value
    local rc

    # v2.0 (#188): managed namespace が唯一の保管場所。security 所有なので
    # プロンプトし得ない。124(timeout) は keychain ロック等 = 125 に変換。
    # それ以外の非 0/44 は権威的失敗 (#150) としてそのまま返す。
    if value=$(security_bounded find-generic-password -s "com.aieo.aikeychain.managed" -a "$key_name" -w); then
        [ -n "$value" ] && { printf '%s' "$value"; return 0; }
        return 1
    else
        rc=$?
        [ "$rc" -eq 124 ] && return 125
        # exit 44 は「見つからない」とは限らない: サンドボックス化された agent
        # シェル等では検索自体が失敗しても 44 を返し、stderr に先行する
        # SecKeychainSearchCreateFromAttributes 等のエラーが出る（実測）。
        # 値を読まないメタデータ照会で stderr を取り直し、not-found 行以外が
        # あれば 126 = keychain に到達できない（キーは存在し得る）として返す。
        if [ "$rc" -eq 44 ]; then
            local probe_rc=0
            keychain_44_is_not_found "$key_name" || probe_rc=$?
            case "$probe_rc" in
                0) return 44 ;;     # 本当に未登録
                124) return 125 ;;  # 再照会がタイムアウト = ロック/不可用
                *) return 126 ;;    # 検索失敗・結果不一致 = 未登録とは判定できない
            esac
        fi
        return "$rc"
    fi
}

# 再照会（値は読まないメタデータ照会）で exit 44 の意味を確かめる。
#   0   = 本当に未登録: 再照会も exit 44 で、stderr が not-found 行のみ / 空
#   124 = 再照会がタイムアウト
#   1   = それ以外（検索自体の失敗・別の終了コード・今度は存在した等）。
#         キーは存在し得るので「未登録」とは言わず fail closed にする。
keychain_44_is_not_found() {
    local err rc other
    if err=$(security_bounded --stderr find-generic-password -s "com.aieo.aikeychain.managed" -a "$1"); then
        rc=0
    else
        rc=$?
    fi
    [ "$rc" -eq 124 ] && return 124
    [ "$rc" -eq 44 ] || return 1
    # grep に頼らず（フィルターの実行失敗を「該当行なし」と取り違えない）、
    # 行全体が not-found 行のときだけ受け入れる。
    printf '%s\n' "$err" | stderr_is_only_not_found || return 1
    return 0
}

# stdin の各行が空行か not-found 行そのもの（`security: ` 接頭辞と末尾の . は任意）なら 0。
stderr_is_only_not_found() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        line="${line#security: }"
        line="${line%.}"
        [ -z "$line" ] && continue
        [ "$line" = "SecKeychainSearchCopyNext: The specified item could not be found in the keychain" ] || return 1
    done
    return 0
}

mask_value() {
    echo "********"
}

cmd_run() {
    local dry_run=false
    local has_separator=false

    # Parse options before --
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --)
                has_separator=true
                shift
                break
                ;;
            *)
                echo "akc: unknown option: $1" >&2
                echo "Usage: akc run [--dry-run] -- <command> [args...]" >&2
                exit 1
                ;;
        esac
    done

    if ! $dry_run && ! $has_separator; then
        echo "akc: missing '--' separator before command" >&2
        echo "Usage: akc run [--dry-run] -- <command> [args...]" >&2
        exit 1
    fi

    # Find and resolve keychain:// references
    local resolved_count=0
    local failed_count=0
    # 失敗種別ごとの件数（まとめ案内の出し分け用）
    local missing_count=0 access_count=0
    local -a export_names=() export_values=()

    while IFS='=' read -r var_name var_value; do
        # Skip if not a keychain:// reference
        case "$var_value" in
            keychain://*)
                # 不正な識別子名の行はスキップする。env の出力を IFS='=' でパースする
                # 都合上、親 env の値に改行が混ざると "bad name=keychain://KEY" のような
                # 行が生成されうる。これをそのまま export に渡すと bash が
                # 「not a valid identifier」エラーを *解決済みシークレット値ごと* stderr に
                # 出力してしまう（#115 が狙う漏洩クラスそのもの）。resolve する前に弾く。
                case "$var_name" in
                    *[!A-Za-z0-9_]* | "" | [0-9]* ) continue ;;
                esac
                local key_name="${var_value#keychain://}"
                local resolved rk_rc
                if resolved=$(resolve_keychain "$key_name"); then
                    rk_rc=0
                else
                    rk_rc=$?
                fi

                if [ "$rk_rc" -eq 0 ] && [ -n "$resolved" ]; then
                    resolved_count=$((resolved_count + 1))
                    if $dry_run; then
                        local masked
                        masked=$(mask_value)
                        echo "  ✅ $var_name = $masked (from keychain://$key_name)"
                    else
                        export_names+=("$var_name")
                        export_values+=("$resolved")
                    fi
                else
                    failed_count=$((failed_count + 1))
                    if [ "$rk_rc" -eq 125 ]; then
                        # managed 段の timeout = keychain ロック/不可用 (#188)
                        echo "  ❌ $var_name — keychain://$key_name: managed read timed out — keychain locked or unavailable. Unlock the login keychain and retry." >&2
                    elif [ "$rk_rc" -eq 126 ]; then
                        access_count=$((access_count + 1))
                        echo "  ❌ $var_name — keychain://$key_name: the Keychain search itself failed or gave inconsistent results in this process (e.g. a sandboxed agent shell) — NOT a missing key. Re-run outside the sandbox via your agent's explicit approval mechanism." >&2
                    elif [ "$rk_rc" -eq 1 ] || [ "$rk_rc" -eq 44 ]; then
                        missing_count=$((missing_count + 1))
                        echo "  ❌ $var_name — keychain://$key_name not found in Keychain" >&2
                    else
                        echo "  ❌ $var_name — keychain://$key_name: keychain lookup failed (exit $rk_rc)" >&2
                    fi
                fi
                ;;
        esac
    done < <("$ENV_BIN")

    if $dry_run; then
        echo ""
        echo "Resolved: $resolved_count, Failed: $failed_count"
        # 案内は失敗種別に合わせる: アクセス不可を「キー未登録」と案内しない
        if [ "$access_count" -gt 0 ]; then
            echo "The keychain could not be searched from this process — the keys were NOT reported missing. Re-run outside the sandbox via your agent's explicit approval mechanism."
        fi
        if [ "$missing_count" -gt 0 ]; then
            echo "Register missing keys in AI KeyChain or macOS Keychain."
        fi
        return 0
    fi

    if [ "$failed_count" -gt 0 ]; then
        echo "akc: $failed_count keychain reference(s) could not be resolved" >&2
        echo "akc: run 'akc run --dry-run' to see details" >&2
        exit 1
    fi

    if [ $# -eq 0 ]; then
        echo "akc: no command specified after '--'" >&2
        exit 1
    fi

    # Export resolved secrets via the shell builtin (no child process, no argv
    # exposure) before exec'ing the target command.
    local i
    for i in "${!export_names[@]}"; do
        export "${export_names[$i]}=${export_values[$i]}"
    done
    exec "$@"
}

# Main dispatch
case "${1:-help}" in
    run)
        shift
        cmd_run "$@"
        ;;
    version)
        echo "akc $VERSION"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "akc: unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac
